{
  "appId": "com.mechanicalshop.pos",
  "productName": "Mechanical Shop POS",
  "copyright": "Copyright © 2026 Mechanical Shop POS",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "build/icon.*",
    // Git-ignored, so a build made without it simply ships with Drive backup
    // switched off rather than failing.
    "google-oauth.json"
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "signAndEditExecutable": false,
    "sign": null,
    "forceCodeSigning": false
  },

  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Mechanical Shop POS",
    "uninstallDisplayName": "Mechanical Shop POS"
  },
  "portable": {
    "artifactName": "${productName}-Portable-${version}.${ext}"
  }
}
