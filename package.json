{
  "name": "mechanical-shop-pos",
  "version": "1.0.0",
  "description": "Offline-first Mechanical Shop POS Desktop Application",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm exec -- vite",
    "build": "npm exec -- vite build && npm exec -- tsc -p tsconfig.electron.json",
    "electron:dev": "node scripts/dev.js",
    "electron:build": "npm run build && npm exec -- electron-builder --win",
    "postinstall": "npm exec -- electron-builder install-app-deps"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.48.1",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.8.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jsbarcode": "^3.11.6",
    "lucide-react": "^0.475.0",
    "pdfmake": "^0.2.18",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/pdfmake": "^0.2.11",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
